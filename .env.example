# ==========================================
# Autonomous AI Agent System Configuration
# ==========================================

# LLM API Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=https://api.openai.com/v1

# Web Search API (Optional: DuckDuckGo is used by default with zero config)
TAVILY_API_KEY=your_tavily_api_key_here

# Agent Execution Limits
MAX_ITERATIONS=15
CONTAINER_TIMEOUT_SECONDS=15
CONTAINER_MEMORY_LIMIT=128m
SANDBOX_IMAGE=python:3.10-slim

# Storage & Sandboxing Paths
WORKSPACE_DIR=./workspace
EXECUTION_TRACE_FILE=execution_trace.jsonl

# Logging & Operational Modes
LOG_LEVEL=INFO
# Set to 'true' to run with the built-in deterministic ReAct engine for offline testing / benchmarks
MOCK_LLM=false
